    "FILE_WRITE": "ASK",
    "PROCESS_START": "DENY",
    "DYNAMIC_CODE": "DENY",
    "SECRET_ACCESS": "DENY"
  },
  "rules": [
    {
      "id": "block-example-domain",
      "enabled": true,
      "decision": "DENY",
      "operation": "HTTP",
      "modId": null,
      "version": null,
      "artifactSha256": null,
      "targetPattern": "*example.invalid*",
      "processPermission": false
    }
  ]
}
